[Unit]
Description=Cog WebKit Kiosk
After=labwc-kiosk.service
BindsTo=labwc-kiosk.service
StartLimitIntervalSec=0

[Service]
User=pi
Environment="WAYLAND_DISPLAY=wayland-0"
Environment="XDG_RUNTIME_DIR=/run/user/1000"
Environment="COG_PLATFORM_WL_VIEW_FULLSCREEN=1"
Environment="XCURSOR_THEME=empty"
ExecStart=/usr/bin/cog -P wl --bg-color=black file:///home/pi/mirrordash/loading.html
# The screen runs the modules' cards: it gets the mirror itself and the internet, not the home network
# (ARCHITECTURE #41). A module shows a camera at home through its own route, not from the page.
IPAddressDeny=localnet link-local multicast 0.0.0.0/8 100.64.0.0/10 240.0.0.0/4 ::/0
IPAddressAllow=localhost
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
